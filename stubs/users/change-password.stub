<?php

declare(strict_types=1);

namespace {{ namespace }}\Users\Pages;

use {{ namespace }}\Users\UserAccounts;
use AlfaSix\Alfakit\Actions\Action;
use AlfaSix\Alfakit\Forms\Components\TextInput;
use AlfaSix\Alfakit\Notifications\Notification;
use AlfaSix\Alfakit\Pages\Page;
use AlfaSix\Alfakit\Schemas\Schema;
use AlfaSix\Alfakit\Support\Enums\Color;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Http\RedirectResponse;
use Illuminate\Support\Facades\Hash;
use Illuminate\Support\Str;
use Illuminate\Validation\Rules\Password;

/**
 * Users an admin flagged with "require a new password" land here until they choose one
 * (see `RequirePasswordChange`).
 */
class ChangePassword extends Page
{
    protected static string $layout = 'auth';

    protected static bool $shouldRegisterNavigation = false;

    protected static bool $isDiscovered = false;

    protected static ?string $slug = 'change-password';

    public function getTitle(): string
    {
        return __('alfakit::users.change_password.title');
    }

    public function getHeading(): ?string
    {
        return __('alfakit::users.change_password.heading');
    }

    public function getSubheading(): ?string
    {
        return __('alfakit::users.change_password.description');
    }

    public function form(Schema $schema): Schema
    {
        $panel = $this->getPanel();
        $revealable = $panel->arePasswordsRevealable();

        return $schema->components([
            TextInput::make('current_password')
                ->label(__('alfakit::users.fields.current_password'))
                ->password()
                ->revealable($revealable)
                ->required()
                ->rule('current_password:'.$panel->getAuthGuard())
                ->dehydrated(false),
            TextInput::make('password')
                ->label(__('alfakit::users.fields.new_password'))
                ->password()
                ->revealable($revealable)
                ->required()
                ->rule(Password::default())
                ->different('current_password')
                ->confirmed(),
            TextInput::make('password_confirmation')
                ->label(__('alfakit::users.fields.password_confirmation'))
                ->password()
                ->revealable($revealable)
                ->required()
                ->dehydrated(false),
        ])->columns(1);
    }

    protected function getFormActions(): array
    {
        return [
            Action::make('save')
                ->label(__('alfakit::users.change_password.submit'))
                ->color(Color::Primary)
                ->button()
                ->extraAttributes(['class' => 'w-full'])
                ->form(fn (): array => $this->getForm()?->getComponents(withHidden: true) ?? [])
                ->action(fn (array $data): RedirectResponse => $this->save($data)),
        ];
    }

    /**
     * @param  array<string, mixed>  $data
     */
    public function save(array $data): RedirectResponse
    {
        $panel = $this->getPanel();
        $user = $panel->auth()->user();

        abort_unless($user instanceof Model, 403);

        $user->forceFill([
            'password' => Hash::make((string) $data['password']),
            'remember_token' => Str::random(60),
            'password_change_required' => false,
        ])->save();

        session()->regenerate();
        UserAccounts::revokeSessions($user);

        Notification::make()->success()->title(__('alfakit::users.change_password.done'))->send();

        return redirect()->to($panel->getUrl());
    }
}
