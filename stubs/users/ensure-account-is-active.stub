<?php

declare(strict_types=1);

namespace {{ namespace }}\Users\Middleware;

use {{ namespace }}\Users\UserAccounts;
use AlfaSix\Alfakit\Notifications\Notification;
use Closure;
use Illuminate\Contracts\Auth\StatefulGuard;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Http\Request;
use Symfony\Component\HttpFoundation\Response;

/**
 * Signs suspended and banned users out of the panel (also sessions that started before
 * the suspension). Registered with `$panel->authMiddleware([...])` by `alfakit:users`, and
 * on the `web` middleware group in `bootstrap/app.php` for starter kit panels, whose users
 * sign in on the app's own login page.
 */
class EnsureAccountIsActive
{
    public function handle(Request $request, Closure $next): Response
    {
        $panel = alfakit()->getCurrentOrDefaultPanel();
        $guard = $panel->auth();
        $user = $guard->user();

        if (! $user instanceof Model || ! UserAccounts::isBlocked($user) || $panel->isImpersonating()) {
            return $next($request);
        }

        $message = __(UserAccounts::status($user) === UserAccounts::BANNED ? 'alfakit::users.blocked.banned' : 'alfakit::users.blocked.suspended');

        if ($guard instanceof StatefulGuard) {
            $guard->logout();
        }

        $request->session()->invalidate();
        $request->session()->regenerateToken();

        // Background requests (AlfaKit's internal endpoints, the starter kit's header
        // components) get an error, never the sign-in page's HTML.
        abort_if($request->expectsJson(), 401, $message);

        Notification::make()
            ->danger()
            ->persistent()
            ->title($message)
            ->send();
        // The starter kits' sign-in pages show the session `status`.
        $request->session()->flash('status', $message);

        $login = $panel->getLoginUrl();

        abort_if($login === null, 403, $message);

        return redirect()->to($login);
    }
}
