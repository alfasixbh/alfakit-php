<?php

declare(strict_types=1);

namespace {{ appNamespace }}Listeners;

use {{ namespace }}\Users\UserAccounts;
use Illuminate\Auth\Events\Login;
use Illuminate\Database\Eloquent\Model;

/**
 * Records `last_login_at` and `last_login_ip` (discovered automatically from app/Listeners).
 * Generated by `php artisan alfakit:users`.
 */
class RecordUserSignIn
{
    public function handle(Login $event): void
    {
        if ($event->user instanceof Model && array_key_exists('last_login_at', $event->user->getAttributes())) {
            UserAccounts::recordSignIn($event->user, request()->ip());
        }
    }
}
