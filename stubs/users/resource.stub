<?php

declare(strict_types=1);

namespace {{ namespace }}\Resources;

use {{ modelClass }};
use {{ namespace }}\Resources\UserResource\Pages;
use {{ namespace }}\Users\UserAccounts;
use AlfaSix\Alfakit\Actions\Action;
use AlfaSix\Alfakit\Actions\ActionGroup;
use AlfaSix\Alfakit\Actions\DeleteAction;
use AlfaSix\Alfakit\Actions\DeleteBulkAction;
use AlfaSix\Alfakit\Actions\EditAction;
use AlfaSix\Alfakit\Actions\ImpersonateAction;
use AlfaSix\Alfakit\Actions\ViewAction;
use AlfaSix\Alfakit\Forms\Components\Select;
use AlfaSix\Alfakit\Forms\Components\Textarea;
use AlfaSix\Alfakit\Forms\Components\TextInput;
use AlfaSix\Alfakit\Forms\Components\Toggle;
use AlfaSix\Alfakit\Infolists\Components\IconEntry;
use AlfaSix\Alfakit\Infolists\Components\RepeatableEntry;
use AlfaSix\Alfakit\Infolists\Components\TextEntry;
use AlfaSix\Alfakit\Resources\Resource;
use AlfaSix\Alfakit\Schemas\Components\Section;
use AlfaSix\Alfakit\Schemas\Schema;
use AlfaSix\Alfakit\Support\Enums\Color;
use AlfaSix\Alfakit\Tables\Columns\TextColumn;
use AlfaSix\Alfakit\Tables\Filters\SelectFilter;
use AlfaSix\Alfakit\Tables\Table;
use Illuminate\Database\Eloquent\Builder;
use Illuminate\Support\Facades\Hash;
use Illuminate\Validation\Rules\Password;

/**
 * Users: invite, impersonate, suspend, ban, require a new password, reset two-factor
 * authentication, see sign-ins and sign users out. Generated by `php artisan alfakit:users`.
 */
class UserResource extends Resource
{
    protected static ?string $model = {{ model }}::class;

    protected static ?string $navigationIcon = 'users';

    protected static ?string $recordTitleAttribute = 'name';

    protected static ?string $slug = 'users';

    /**
     * Accounts are not owned by a tenant: on tenancy panels the resource lists every user.
     * To list only the current tenant's members, remove this and set
     * `protected static ?string $tenantOwnershipRelationshipName = 'teams';`.
     */
    protected static bool $isScopedToTenant = false;

    public static function getModelLabel(): string
    {
        return __('alfakit::users.model_label');
    }

    public static function getPluralModelLabel(): string
    {
        return __('alfakit::users.plural_model_label');
    }

    public static function form(Schema $schema): Schema
    {
        return $schema
            ->components([
                Section::make(__('alfakit::users.sections.account'))
                    ->schema([
                        TextInput::make('name')
                            ->label(__('alfakit::users.fields.name'))
                            ->required()
                            ->maxLength(255),
                        TextInput::make('email')
                            ->label(__('alfakit::users.fields.email'))
                            ->email()
                            ->required()
                            ->maxLength(255)
                            ->unique(ignoreRecord: true),
                        TextInput::make('password')
                            ->label(__('alfakit::users.fields.password'))
                            ->password()
                            ->revealable()
                            ->required(fn (string $operation): bool => $operation === 'create')
                            ->rule(Password::default())
                            ->dehydrated(fn (?string $state): bool => filled($state))
                            ->dehydrateStateUsing(fn (string $state): string => Hash::make($state))
                            ->helperText(fn (string $operation) => $operation === 'edit' ? __('alfakit::users.fields.password_help') : null),
{{ rolesFormField }}                        Toggle::make('password_change_required')
                            ->label(__('alfakit::users.fields.password_change_required'))
                            ->helperText(__('alfakit::users.fields.password_change_required_help')),
                    ])
                    ->columns(2),
            ]);
    }

    public static function infolist(Schema $schema): Schema
    {
        return $schema
            ->components([
                Section::make(__('alfakit::users.sections.account'))
                    ->schema([
                        TextEntry::make('name')->label(__('alfakit::users.fields.name')),
                        TextEntry::make('email')->label(__('alfakit::users.fields.email'))->copyable(),
                        TextEntry::make('status')
                            ->label(__('alfakit::users.fields.status'))
                            ->getStateUsing(fn ({{ model }} $record): string => UserAccounts::status($record))
                            ->formatStateUsing(fn (string $state): string => UserAccounts::statusLabel($state))
                            ->badge()
                            ->color(fn (string $state): string => UserAccounts::statusColor($state)),
{{ rolesEntry }}                        TextEntry::make('ban_reason')
                            ->label(__('alfakit::users.fields.ban_reason'))
                            ->visible(fn ({{ model }} $record): bool => UserAccounts::status($record) === UserAccounts::BANNED)
                            ->placeholder('—'),
                        TextEntry::make('created_at')->label(__('alfakit::users.fields.created_at'))->dateTime(),
                    ])
                    ->columns(2),
                Section::make(__('alfakit::users.sections.security'))
                    ->schema([
                        TextEntry::make('last_login_at')
                            ->label(__('alfakit::users.fields.last_login_at'))
                            ->since()
                            ->placeholder(__('alfakit::users.never')),
                        TextEntry::make('last_login_ip')
                            ->label(__('alfakit::users.fields.last_login_ip'))
                            ->placeholder('—'),
                        IconEntry::make('two_factor')
                            ->label(__('alfakit::users.fields.two_factor'))
                            ->getStateUsing(fn ({{ model }} $record): bool => UserAccounts::hasTwoFactor($record))
                            ->boolean(),
                        IconEntry::make('password_change_required')
                            ->label(__('alfakit::users.fields.password_change_required'))
                            ->boolean(),
                    ])
                    ->columns(2),
                Section::make(__('alfakit::users.sessions.heading'))
                    ->description(__('alfakit::users.sessions.description'))
                    ->visible(fn (): bool => UserAccounts::usesDatabaseSessions())
                    ->schema([
                        RepeatableEntry::make('sessions')
                            ->hiddenLabel()
                            ->getStateUsing(fn ({{ model }} $record): array => UserAccounts::sessions($record))
                            ->placeholder(__('alfakit::users.sessions.empty'))
                            ->schema([
                                TextEntry::make('device')->label(__('alfakit::users.sessions.device')),
                                TextEntry::make('ip_address')->label(__('alfakit::users.sessions.ip_address'))->placeholder('—'),
                                TextEntry::make('last_active')->label(__('alfakit::users.sessions.last_active'))->since(),
                            ])
                            ->columns(3),
                    ]),
            ]);
    }

    public static function table(Table $table): Table
    {
        return $table
            ->columns([
                TextColumn::make('name')
                    ->label(__('alfakit::users.fields.name'))
                    ->searchable()
                    ->sortable(),
                TextColumn::make('email')
                    ->label(__('alfakit::users.fields.email'))
                    ->searchable()
                    ->sortable(),
{{ rolesColumn }}                TextColumn::make('status')
                    ->label(__('alfakit::users.fields.status'))
                    ->getStateUsing(fn ({{ model }} $record): string => UserAccounts::status($record))
                    ->formatStateUsing(fn (string $state): string => UserAccounts::statusLabel($state))
                    ->badge()
                    ->color(fn (string $state): string => UserAccounts::statusColor($state)),
                TextColumn::make('last_login_at')
                    ->label(__('alfakit::users.fields.last_login_at'))
                    ->since()
                    ->sortable()
                    ->placeholder(__('alfakit::users.never')),
                TextColumn::make('created_at')
                    ->label(__('alfakit::users.fields.created_at'))
                    ->dateTime()
                    ->sortable()
                    ->toggleable(isToggledHiddenByDefault: true),
            ])
            ->defaultSort('created_at', 'desc')
            ->filters([
                SelectFilter::make('status')
                    ->label(__('alfakit::users.fields.status'))
                    ->options(UserAccounts::statusOptions())
                    ->query(fn (Builder $query, array $data): Builder => static::whereStatus($query, $data['value'] ?? null)),
{{ rolesFilter }}            ])
            ->recordActions([
                ViewAction::make(),
                EditAction::make(),
                ActionGroup::make([
                    ImpersonateAction::make()
                        ->visible(fn ({{ model }} $record): bool => ! UserAccounts::isBlocked($record)),
                    ...static::accountActions(),
                    DeleteAction::make()
                        ->hidden(fn ({{ model }} $record): bool => UserAccounts::isCurrentUser($record)),
                ]),
            ])
            ->bulkActions([
                DeleteBulkAction::make(),
            ]);
    }

    /**
     * Suspend, ban, require a new password, reset two-factor authentication and resend
     * the invitation: on the table rows and the view page.
     *
     * @return array<int, Action>
     */
    public static function accountActions(): array
    {
        return [
            Action::make('resendInvitation')
                ->label(__('alfakit::users.actions.resend_invitation.label'))
                ->authorize(fn ({{ model }} $record): bool => static::can('update', $record))
                ->icon('mail')
                ->visible(fn ({{ model }} $record): bool => UserAccounts::isInvitationPending($record))
                ->action(fn ({{ model }} $record) => UserAccounts::sendInvitation($record, alfakit()->getCurrentOrDefaultPanel()))
                ->successNotificationTitle(__('alfakit::users.actions.resend_invitation.done')),
            Action::make('suspend')
                ->label(__('alfakit::users.actions.suspend.label'))
                ->authorize(fn ({{ model }} $record): bool => static::can('update', $record))
                ->icon('circle-pause')
                ->color(Color::Warning)
                ->requiresConfirmation()
                ->modalDescription(__('alfakit::users.actions.suspend.description'))
                ->visible(fn ({{ model }} $record): bool => UserAccounts::status($record) !== UserAccounts::SUSPENDED && ! UserAccounts::isCurrentUser($record))
                ->action(fn ({{ model }} $record) => UserAccounts::suspend($record))
                ->successNotificationTitle(__('alfakit::users.actions.suspend.done')),
            Action::make('unsuspend')
                ->label(__('alfakit::users.actions.unsuspend.label'))
                ->authorize(fn ({{ model }} $record): bool => static::can('update', $record))
                ->icon('circle-play')
                ->color(Color::Success)
                ->requiresConfirmation()
                ->visible(fn ({{ model }} $record): bool => UserAccounts::status($record) === UserAccounts::SUSPENDED)
                ->action(fn ({{ model }} $record) => UserAccounts::unsuspend($record))
                ->successNotificationTitle(__('alfakit::users.actions.unsuspend.done')),
            Action::make('ban')
                ->label(__('alfakit::users.actions.ban.label'))
                ->authorize(fn ({{ model }} $record): bool => static::can('update', $record))
                ->icon('ban')
                ->color(Color::Danger)
                ->modalDescription(__('alfakit::users.actions.ban.description'))
                ->schema([
                    Textarea::make('reason')
                        ->label(__('alfakit::users.fields.ban_reason'))
                        ->maxLength(500),
                ])
                ->visible(fn ({{ model }} $record): bool => UserAccounts::status($record) !== UserAccounts::BANNED && ! UserAccounts::isCurrentUser($record))
                ->action(fn ({{ model }} $record, array $data) => UserAccounts::ban($record, is_string($data['reason'] ?? null) ? $data['reason'] : null))
                ->successNotificationTitle(__('alfakit::users.actions.ban.done')),
            Action::make('unban')
                ->label(__('alfakit::users.actions.unban.label'))
                ->authorize(fn ({{ model }} $record): bool => static::can('update', $record))
                ->icon('shield-check')
                ->color(Color::Success)
                ->requiresConfirmation()
                ->visible(fn ({{ model }} $record): bool => UserAccounts::status($record) === UserAccounts::BANNED)
                ->action(fn ({{ model }} $record) => UserAccounts::unban($record))
                ->successNotificationTitle(__('alfakit::users.actions.unban.done')),
            Action::make('requirePasswordChange')
                ->label(__('alfakit::users.actions.require_password_change.label'))
                ->authorize(fn ({{ model }} $record): bool => static::can('update', $record))
                ->icon('key-round')
                ->requiresConfirmation()
                ->modalDescription(__('alfakit::users.actions.require_password_change.description'))
                ->visible(fn ({{ model }} $record): bool => ! UserAccounts::mustChangePassword($record) && ! UserAccounts::isCurrentUser($record))
                ->action(fn ({{ model }} $record) => UserAccounts::requirePasswordChange($record))
                ->successNotificationTitle(__('alfakit::users.actions.require_password_change.done')),
            Action::make('resetTwoFactor')
                ->label(__('alfakit::users.actions.reset_two_factor.label'))
                ->authorize(fn ({{ model }} $record): bool => static::can('update', $record))
                ->icon('shield-off')
                ->color(Color::Danger)
                ->requiresConfirmation()
                ->modalDescription(__('alfakit::users.actions.reset_two_factor.description'))
                ->visible(fn ({{ model }} $record): bool => UserAccounts::hasTwoFactor($record))
                ->action(fn ({{ model }} $record) => UserAccounts::resetTwoFactor($record))
                ->successNotificationTitle(__('alfakit::users.actions.reset_two_factor.done')),
        ];
    }

    /**
     * Revoke one session or all of them (database session driver only).
     *
     * @return array<int, Action>
     */
    public static function sessionActions(): array
    {
        return [
            Action::make('revokeSession')
                ->label(__('alfakit::users.actions.revoke_session.label'))
                ->authorize(fn ({{ model }} $record): bool => static::can('update', $record))
                ->icon('log-out')
                ->schema(fn ({{ model }} $record): array => [
                    Select::make('session')
                        ->label(__('alfakit::users.actions.revoke_session.session'))
                        ->options(UserAccounts::sessionOptions($record))
                        ->required(),
                ])
                ->visible(fn ({{ model }} $record): bool => UserAccounts::usesDatabaseSessions() && UserAccounts::sessions($record) !== [])
                ->action(fn ({{ model }} $record, array $data) => UserAccounts::revokeSession($record, (string) $data['session']))
                ->successNotificationTitle(__('alfakit::users.actions.revoke_session.done')),
            Action::make('revokeSessions')
                ->label(__('alfakit::users.actions.revoke_sessions.label'))
                ->authorize(fn ({{ model }} $record): bool => static::can('update', $record))
                ->icon('monitor-off')
                ->color(Color::Danger)
                ->requiresConfirmation()
                ->modalDescription(__('alfakit::users.actions.revoke_sessions.description'))
                ->visible(fn ({{ model }} $record): bool => UserAccounts::usesDatabaseSessions() && UserAccounts::sessions($record) !== [])
                ->action(fn ({{ model }} $record) => UserAccounts::revokeSessions($record))
                ->successNotificationTitle(__('alfakit::users.actions.revoke_sessions.done')),
        ];
    }

    /**
     * The "Invite user" header action of the list page.
     */
    public static function inviteAction(): Action
    {
        return Action::make('invite')
            ->label(__('alfakit::users.actions.invite.label'))
            ->authorize(fn (): bool => static::can('create'))
            ->icon('mail-plus')
            ->modalHeading(__('alfakit::users.actions.invite.heading'))
            ->modalDescription(__('alfakit::users.actions.invite.description'))
            ->modalSubmitActionLabel(__('alfakit::users.actions.invite.submit'))
            ->schema([
                TextInput::make('name')
                    ->label(__('alfakit::users.fields.name'))
                    ->required()
                    ->maxLength(255),
                TextInput::make('email')
                    ->label(__('alfakit::users.fields.email'))
                    ->email()
                    ->required()
                    ->maxLength(255)
                    ->unique(table: fn (): string => (new {{ model }})->getTable(), column: 'email'),
{{ rolesInviteField }}            ])
            ->action(fn (array $data) => UserAccounts::invite({{ model }}::class, $data, alfakit()->getCurrentOrDefaultPanel()))
            ->successNotificationTitle(__('alfakit::users.actions.invite.done'));
    }

    /**
     * @param  Builder<{{ model }}>  $query
     * @return Builder<{{ model }}>
     */
    protected static function whereStatus(Builder $query, mixed $status): Builder
    {
        return match ($status) {
            UserAccounts::BANNED => $query->whereNotNull('banned_at'),
            UserAccounts::SUSPENDED => $query->whereNull('banned_at')->whereNotNull('suspended_at'),
            UserAccounts::INVITED => $query->whereNull('banned_at')->whereNull('suspended_at')->whereNotNull('invited_at'),
            UserAccounts::ACTIVE => $query->whereNull('banned_at')->whereNull('suspended_at')->whereNull('invited_at'),
            default => $query,
        };
    }

    public static function getRelations(): array
    {
        return [
            //
        ];
    }

    public static function getPages(): array
    {
        return [
            'index' => Pages\ListUsers::route('/'),
            'create' => Pages\CreateUser::route('/create'),
            'view' => Pages\ViewUser::route('/{record}'),
            'edit' => Pages\EditUser::route('/{record}/edit'),
        ];
    }
}
