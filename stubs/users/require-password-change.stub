<?php

declare(strict_types=1);

namespace {{ namespace }}\Users\Middleware;

use {{ namespace }}\Users\Pages\ChangePassword;
use {{ namespace }}\Users\UserAccounts;
use AlfaSix\Alfakit\Panel;
use AlfaSix\Alfakit\Support\SchemaContext;
use Closure;
use Illuminate\Contracts\Auth\Authenticatable;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Http\Request;
use Symfony\Component\HttpFoundation\Response;

/**
 * Sends users that must choose a new password to the change-password page first.
 * Registered with `$panel->authMiddleware([...])` by `alfakit:users`.
 */
class RequirePasswordChange
{
    public function handle(Request $request, Closure $next): Response
    {
        $panel = alfakit()->getCurrentOrDefaultPanel();
        $user = $panel->auth()->user();

        if (
            ! $user instanceof Model
            || ! UserAccounts::mustChangePassword($user)
            || $panel->isImpersonating()
            || $this->isChangePasswordRequest($request, $panel)
        ) {
            return $next($request);
        }

        return redirect()->to(ChangePassword::getUrl($this->tenantParameters($request, $panel, $user), panel: $panel));
    }

    /**
     * On tenancy panels the page lives under a tenant, which isn't identified yet while the
     * auth middleware runs: the tenant of the URL, else the user's default one.
     *
     * @return array<string, mixed>
     */
    protected function tenantParameters(Request $request, Panel $panel, Model $user): array
    {
        if (! $panel->hasTenancy()) {
            return [];
        }

        $tenant = $request->route('tenant') ?? ($user instanceof Authenticatable ? $panel->getDefaultTenant($user) : null);

        return $tenant === null ? [] : ['tenant' => $tenant];
    }

    /**
     * The change-password page itself, or an internal request (form refresh, the save
     * action) from it, which carries the page in its context token.
     */
    protected function isChangePasswordRequest(Request $request, Panel $panel): bool
    {
        if ($request->routeIs($panel->generateRouteName(ChangePassword::getRelativeRouteName()))) {
            return true;
        }

        $token = $request->input('token') ?? $request->query('token');

        if (! is_string($token) || $token === '') {
            return false;
        }

        try {
            return SchemaContext::fromToken($token)->page === ChangePassword::class;
        } catch (\Throwable) {
            return false;
        }
    }
}
