<?php

declare(strict_types=1);

namespace {{ namespace }}\Users;

use AlfaSix\Alfakit\Auth\MultiFactor\App\Contracts\HasAppAuthentication;
use AlfaSix\Alfakit\Auth\MultiFactor\App\Contracts\HasAppAuthenticationRecovery;
use AlfaSix\Alfakit\Auth\MultiFactor\Email\Contracts\HasEmailAuthentication;
use AlfaSix\Alfakit\Panel;
use Illuminate\Contracts\Auth\Authenticatable;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Query\Builder;
use Illuminate\Support\Carbon;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Hash;
use Illuminate\Support\Facades\URL;
use Illuminate\Support\Str;
use stdClass;

/**
 * Account management for the users resource: status (invited, active, suspended,
 * banned), invitations, forced password changes, two-factor resets, sign-in tracking and
 * sessions (database session driver only). Generated by `php artisan alfakit:users`.
 */
final class UserAccounts
{
    public const ACTIVE = 'active';

    public const INVITED = 'invited';

    public const SUSPENDED = 'suspended';

    public const BANNED = 'banned';

    /** How long an invitation link stays valid. */
    public const INVITATION_DAYS = 7;

    public static function status(Model $user): string
    {
        return match (true) {
            self::value($user, 'banned_at') !== null => self::BANNED,
            self::value($user, 'suspended_at') !== null => self::SUSPENDED,
            self::value($user, 'invited_at') !== null => self::INVITED,
            default => self::ACTIVE,
        };
    }

    /**
     * @return array<string, string>
     */
    public static function statusOptions(): array
    {
        return [
            self::ACTIVE => __('alfakit::users.status.active'),
            self::INVITED => __('alfakit::users.status.invited'),
            self::SUSPENDED => __('alfakit::users.status.suspended'),
            self::BANNED => __('alfakit::users.status.banned'),
        ];
    }

    public static function statusLabel(string $status): string
    {
        return self::statusOptions()[$status] ?? $status;
    }

    public static function statusColor(string $status): string
    {
        return match ($status) {
            self::ACTIVE => 'success',
            self::INVITED => 'info',
            self::SUSPENDED => 'warning',
            default => 'danger',
        };
    }

    /**
     * Suspended and banned users can't use the panel.
     */
    public static function isBlocked(Model $user): bool
    {
        return in_array(self::status($user), [self::SUSPENDED, self::BANNED], true);
    }

    public static function isCurrentUser(Model $user): bool
    {
        $current = alfakit()->getCurrentOrDefaultPanel()->auth()->user();

        return $current instanceof Model && $current->is($user);
    }

    public static function suspend(Model $user): void
    {
        $user->forceFill(['suspended_at' => now()])->save();

        self::revokeSessions($user);
    }

    public static function unsuspend(Model $user): void
    {
        $user->forceFill(['suspended_at' => null])->save();
    }

    public static function ban(Model $user, ?string $reason = null): void
    {
        $user->forceFill(['banned_at' => now(), 'ban_reason' => $reason])->save();

        self::revokeSessions($user);
    }

    public static function unban(Model $user): void
    {
        $user->forceFill(['banned_at' => null, 'ban_reason' => null])->save();
    }

    // ------------------------------------------------------------------ Passwords

    public static function mustChangePassword(Model $user): bool
    {
        return (bool) self::value($user, 'password_change_required');
    }

    public static function requirePasswordChange(Model $user, bool $required = true): void
    {
        $user->forceFill(['password_change_required' => $required])->save();
    }

    // ------------------------------------------------------------------ Two-factor authentication

    public static function hasTwoFactor(Model $user): bool
    {
        return ($user instanceof HasAppAuthentication && filled($user->getAppAuthenticationSecret()))
            || ($user instanceof HasEmailAuthentication && $user->hasEmailAuthentication())
            || filled(self::value($user, 'two_factor_secret'));
    }

    /**
     * Turn off every second factor (AlfaKit's app and email codes, and Fortify's columns
     * when the table has them), so the user signs in with their password and sets it up again.
     */
    public static function resetTwoFactor(Model $user): void
    {
        if ($user instanceof HasAppAuthentication) {
            $user->saveAppAuthenticationSecret(null);
        }

        if ($user instanceof HasAppAuthenticationRecovery) {
            $user->saveAppAuthenticationRecoveryCodes(null);
        }

        if ($user instanceof HasEmailAuthentication) {
            $user->toggleEmailAuthentication(false);
        }

        $fortify = array_intersect_key(
            ['two_factor_secret' => null, 'two_factor_recovery_codes' => null, 'two_factor_confirmed_at' => null],
            $user->getAttributes(),
        );

        if ($fortify !== []) {
            $user->forceFill($fortify)->save();
        }
    }

    /**
     * Role options for the invite form (spatie/laravel-permission).
     *
     * @return array<int|string, string>
     */
    public static function roleOptions(): array
    {
        $model = config('permission.models.role', 'Spatie\\Permission\\Models\\Role');

        if (! is_string($model) || ! is_a($model, Model::class, true)) {
            return [];
        }

        /** @var array<int|string, string> */
        return $model::query()->orderBy('name')->pluck('name', 'name')->all();
    }

    // ------------------------------------------------------------------ Invitations

    /**
     * Create a user with an unusable password and e-mail them a link to choose one.
     *
     * @param  class-string<Model>  $model
     * @param  array<string, mixed>  $data  `name`, `email` and optionally `roles`
     */
    public static function invite(string $model, array $data, Panel $panel): Model
    {
        $user = new $model;

        $user->forceFill([
            'name' => $data['name'],
            'email' => $data['email'],
            'password' => Hash::make(Str::random(64)),
            'invited_at' => now(),
        ])->save();

        $roles = $data['roles'] ?? [];

        if (is_array($roles) && $roles !== [] && method_exists($user, 'syncRoles')) {
            $user->syncRoles($roles);
        }

        self::sendInvitation($user, $panel);

        return $user;
    }

    public static function sendInvitation(Model $user, Panel $panel): void
    {
        if (method_exists($user, 'notify')) {
            $user->notify(new UserInvitation(self::invitationUrl($user, $panel), (string) config('app.name')));
        }
    }

    public static function invitationUrl(Model $user, Panel $panel): string
    {
        return URL::temporarySignedRoute(
            $panel->generateRouteName('auth.invitation.accept'),
            now()->addDays(self::INVITATION_DAYS),
            ['user' => $user->getKey(), 'hash' => self::invitationHash($user)],
        );
    }

    /**
     * Ties a link to the user's current password, so it stops working once used.
     */
    public static function invitationHash(Model $user): string
    {
        return hash_hmac('sha256', $user->getKey().'|'.self::value($user, 'email').'|'.self::value($user, 'password'), (string) config('app.key'));
    }

    public static function isInvitationPending(Model $user): bool
    {
        return self::status($user) === self::INVITED;
    }

    public static function acceptInvitation(Model $user, string $password): void
    {
        $user->forceFill([
            'password' => Hash::make($password),
            'remember_token' => Str::random(60),
            'invited_at' => null,
        ]);

        if (array_key_exists('email_verified_at', $user->getAttributes()) && self::value($user, 'email_verified_at') === null) {
            $user->forceFill(['email_verified_at' => now()]);
        }

        $user->save();
    }

    // ------------------------------------------------------------------ Sign-ins and sessions

    public static function recordSignIn(Model $user, ?string $ip): void
    {
        $values = ['last_login_at' => now(), 'last_login_ip' => $ip];

        // Without touching updated_at.
        $user->newQueryWithoutScopes()->whereKey($user->getKey())->toBase()->update($values);
        $user->forceFill($values)->syncOriginalAttributes(array_keys($values));
    }

    public static function usesDatabaseSessions(): bool
    {
        return config('session.driver') === 'database';
    }

    /**
     * The user's sessions, most recent first (database session driver only).
     *
     * @return array<int, array{id: string, ip_address: ?string, device: string, last_active: Carbon, is_current: bool}>
     */
    public static function sessions(Model $user): array
    {
        if (! self::usesDatabaseSessions() || ! $user instanceof Authenticatable) {
            return [];
        }

        return self::sessionsTable()
            ->where('user_id', $user->getAuthIdentifier())
            ->orderByDesc('last_activity')
            ->get()
            ->map(static fn (stdClass $session): array => [
                'id' => (string) $session->id,
                'ip_address' => isset($session->ip_address) ? (string) $session->ip_address : null,
                'device' => self::describeUserAgent(isset($session->user_agent) ? (string) $session->user_agent : ''),
                'last_active' => Carbon::createFromTimestamp((int) $session->last_activity),
                'is_current' => (string) $session->id === session()->getId(),
            ])
            ->all();
    }

    /**
     * @return array<string, string>
     */
    public static function sessionOptions(Model $user): array
    {
        $options = [];

        foreach (self::sessions($user) as $session) {
            $options[$session['id']] = trim($session['device'].' · '.($session['ip_address'] ?? '?').' · '.$session['last_active']->diffForHumans());
        }

        return $options;
    }

    public static function revokeSession(Model $user, string $id): void
    {
        if (! self::usesDatabaseSessions() || ! $user instanceof Authenticatable) {
            return;
        }

        self::sessionsTable()->where('user_id', $user->getAuthIdentifier())->where('id', $id)->delete();
    }

    /**
     * Sign the user out everywhere (except the current session, which is kept when it
     * belongs to someone else, e.g. the admin doing this).
     */
    public static function revokeSessions(Model $user): int
    {
        if (! self::usesDatabaseSessions() || ! $user instanceof Authenticatable) {
            return 0;
        }

        return self::sessionsTable()
            ->where('user_id', $user->getAuthIdentifier())
            ->where('id', '!=', session()->getId())
            ->delete();
    }

    public static function describeUserAgent(string $userAgent): string
    {
        if ($userAgent === '') {
            return __('alfakit::users.sessions.unknown_device');
        }

        $browser = match (true) {
            str_contains($userAgent, 'Edg/') => 'Edge',
            str_contains($userAgent, 'OPR/') => 'Opera',
            str_contains($userAgent, 'Firefox/') => 'Firefox',
            str_contains($userAgent, 'Chrome/') => 'Chrome',
            str_contains($userAgent, 'Safari/') => 'Safari',
            default => null,
        };

        $platform = match (true) {
            str_contains($userAgent, 'iPhone'), str_contains($userAgent, 'iPad') => 'iOS',
            str_contains($userAgent, 'Android') => 'Android',
            str_contains($userAgent, 'Windows') => 'Windows',
            str_contains($userAgent, 'Mac OS X') => 'macOS',
            str_contains($userAgent, 'Linux') => 'Linux',
            default => null,
        };

        return $browser === null && $platform === null
            ? Str::limit($userAgent, 60)
            : trim(($browser ?? '').' · '.($platform ?? ''), ' ·');
    }

    /**
     * An attribute only when the row has it (works with `Model::shouldBeStrict()`).
     */
    private static function value(Model $user, string $key): mixed
    {
        return array_key_exists($key, $user->getAttributes()) ? $user->getAttribute($key) : null;
    }

    private static function sessionsTable(): Builder
    {
        $connection = config('session.connection');

        return DB::connection(is_string($connection) ? $connection : null)->table((string) config('session.table', 'sessions'));
    }
}
