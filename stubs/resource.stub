<?php

declare(strict_types=1);

namespace {{ namespace }};

use {{ namespace }}\{{ resource }}\Pages;
use {{ modelClass }};
use AlfaSix\Alfakit\Actions\DeleteAction;
use AlfaSix\Alfakit\Actions\DeleteBulkAction;
use AlfaSix\Alfakit\Actions\EditAction;
{{ softDeletesImports }}{{ viewActionImport }}use AlfaSix\Alfakit\Forms\Components\TextInput;
{{ imports }}
use AlfaSix\Alfakit\Resources\Resource;
use AlfaSix\Alfakit\Schemas\Schema;
use AlfaSix\Alfakit\Tables\Columns\TextColumn;
{{ filtersImport }}use AlfaSix\Alfakit\Tables\Table;

class {{ resource }} extends Resource
{
    protected static ?string $model = {{ model }}::class;

    protected static ?string $navigationIcon = 'file-text';{{ recordTitleAttribute }}

    public static function form(Schema $schema): Schema
    {
        return $schema
            ->components([
{{ formFields }}
            ]);
    }{{ infolist }}

    public static function table(Table $table): Table
    {
        return $table
            ->columns([
{{ tableColumns }}
            ])
            ->filters([{{ filters }}
            ])
            ->recordActions([{{ viewAction }}
                EditAction::make(),
                DeleteAction::make(),{{ softDeletesActions }}
            ])
            ->bulkActions([
                DeleteBulkAction::make(),{{ softDeletesBulkActions }}
            ]);
    }

    public static function getRelations(): array
    {
        return [
{{ relations }}
        ];
    }

    public static function getPages(): array
    {
        return [
            'index' => Pages\List{{ plural }}::route('/'),
            'create' => Pages\Create{{ model }}::route('/create'),{{ viewPage }}
            'edit' => Pages\Edit{{ model }}::route('/{record}/edit'),
        ];
    }{{ softDeletesQuery }}
}
