<script lang="ts">
    import { Icon, useAlfakitNavigation } from '@alfakit/svelte';
    import { Link } from '@inertiajs/svelte';
    import {
        SidebarGroup,
        SidebarGroupLabel,
        SidebarMenu,
        SidebarMenuButton,
        SidebarMenuItem,
    } from '@/components/ui/sidebar';

    /**
     * The AlfaKit panel navigation (resources, pages, groups, badges) in the app sidebar,
     * built from the app's own sidebar primitives. Generated by
     * `alfakit:install --starter-kit`; edit it like any other component of your app.
     */
    const navigation = useAlfakitNavigation();
</script>

{#each navigation.groups as group (group.key)}
    <SidebarGroup class="px-2 py-0">
        {#if group.label}
            <SidebarGroupLabel>{group.label}</SidebarGroupLabel>
        {/if}
        <SidebarMenu>
            {#each group.items as item (item.key)}
                <SidebarMenuItem>
                    <SidebarMenuButton
                        asChild
                        isActive={item.isActive}
                        tooltip={item.title}
                    >
                        {#snippet children(props)}
                            <Link
                                {...props}
                                href={item.href}
                                class={props.class}
                                target={item.openInNewTab ? '_blank' : undefined}
                            >
                                {#if item.icon}
                                    <Icon name={item.icon} class="size-4 shrink-0" />
                                {/if}
                                <span>{item.title}</span>
                                {#if item.badge !== undefined}
                                    <span
                                        class="ms-auto rounded-md px-1 text-xs font-medium tabular-nums group-data-[collapsible=icon]:hidden"
                                        title={item.badgeTooltip}
                                    >
                                        {item.badge}
                                    </span>
                                {/if}
                            </Link>
                        {/snippet}
                    </SidebarMenuButton>
                    {#if item.children.length > 0}
                        <SidebarMenu
                            class="ms-3.5 border-s border-sidebar-border ps-2.5 group-data-[collapsible=icon]:hidden"
                        >
                            {#each item.children as child (child.key)}
                                <SidebarMenuItem>
                                    <SidebarMenuButton asChild isActive={child.isActive}>
                                        {#snippet children(props)}
                                            <Link
                                                {...props}
                                                href={child.href}
                                                class={props.class}
                                            >
                                                <span>{child.title}</span>
                                            </Link>
                                        {/snippet}
                                    </SidebarMenuButton>
                                </SidebarMenuItem>
                            {/each}
                        </SidebarMenu>
                    {/if}
                </SidebarMenuItem>
            {/each}
        </SidebarMenu>
    </SidebarGroup>
{/each}
