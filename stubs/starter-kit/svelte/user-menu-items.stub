<script lang="ts">
    import { Icon, useAlfakitNavigation } from '@alfakit/svelte';
    import { Link } from '@inertiajs/svelte';
    import {
        DropdownMenuGroup,
        DropdownMenuItem,
        DropdownMenuSeparator,
    } from '@/components/ui/dropdown-menu';

    /**
     * The AlfaKit panel's user menu entries (`userMenuItems()`, plugin entries such as
     * Billing's) in the app's user menu, built from the app's own dropdown items. Renders
     * nothing while the panel has none. Generated by `alfakit:install --starter-kit`; edit
     * it like any other component of your app.
     */
    const navigation = useAlfakitNavigation();
</script>

{#if navigation.userMenuItems.length > 0}
    <DropdownMenuSeparator />
    <DropdownMenuGroup>
        {#each navigation.userMenuItems as item (item.key)}
            {#if item.startsGroup}
                <DropdownMenuSeparator />
            {/if}
            <DropdownMenuItem asChild>
                {#snippet children(props)}
                    {#if item.openInNewTab}
                        <a
                            class={props.class}
                            href={item.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            onclick={props.onClick}
                        >
                            {#if item.icon}
                                <Icon name={item.icon} class="me-2 size-4" />
                            {/if}
                            {item.title}
                        </a>
                    {:else}
                        <Link
                            class={props.class}
                            href={item.href}
                            method={item.method}
                            as={item.method === 'post' ? 'button' : undefined}
                            onclick={props.onClick}
                        >
                            {#if item.icon}
                                <Icon name={item.icon} class="me-2 size-4" />
                            {/if}
                            {item.title}
                        </Link>
                    {/if}
                {/snippet}
            </DropdownMenuItem>
        {/each}
    </DropdownMenuGroup>
{/if}
