<script setup lang="ts">
import { Icon, useAlfakitNavigation } from '@alfakit/vue';
import { Link } from '@inertiajs/vue3';
import {
    DropdownMenuGroup,
    DropdownMenuItem,
    DropdownMenuSeparator,
} from '@/components/ui/dropdown-menu';

/**
 * The AlfaKit panel's user menu entries (`userMenuItems()`, plugin entries such as
 * Billing's) in the app's user menu, built from the app's own dropdown items. Renders
 * nothing while the panel has none. Generated by `alfakit:install --starter-kit`; edit it
 * like any other component of your app.
 */
const navigation = useAlfakitNavigation();
</script>

<template>
    <template v-if="navigation.userMenuItems.length > 0">
        <DropdownMenuSeparator />
        <DropdownMenuGroup>
            <template v-for="item in navigation.userMenuItems" :key="item.key">
                <DropdownMenuSeparator v-if="item.startsGroup" />
                <DropdownMenuItem :as-child="true">
                    <a
                        v-if="item.openInNewTab"
                        class="block w-full cursor-pointer"
                        :href="item.href"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <Icon v-if="item.icon" :name="item.icon" class="me-2 size-4" />
                        {{ item.title }}
                    </a>
                    <Link
                        v-else
                        class="block w-full cursor-pointer"
                        :href="item.href"
                        :method="item.method"
                        :as="item.method === 'post' ? 'button' : 'a'"
                    >
                        <Icon v-if="item.icon" :name="item.icon" class="me-2 size-4" />
                        {{ item.title }}
                    </Link>
                </DropdownMenuItem>
            </template>
        </DropdownMenuGroup>
    </template>
</template>
