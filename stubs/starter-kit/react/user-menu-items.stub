import { Icon, useAlfakitNavigation } from '@alfakit/react';
import { Link } from '@inertiajs/react';
import { Fragment } from 'react';
import {
    DropdownMenuGroup,
    DropdownMenuItem,
    DropdownMenuSeparator,
} from '@/components/ui/dropdown-menu';

/**
 * The AlfaKit panel's user menu entries (`userMenuItems()`, plugin entries such as
 * Billing's) in the app's user menu, built from the app's own dropdown items. Renders
 * nothing while the panel has none. Generated by `alfakit:install --starter-kit`; edit it
 * like any other component of your app.
 */
export function AlfakitUserMenuItems() {
    const { userMenuItems } = useAlfakitNavigation();

    if (userMenuItems.length === 0) {
        return null;
    }

    return (
        <>
            <DropdownMenuSeparator />
            <DropdownMenuGroup>
                {userMenuItems.map((item) => (
                    <Fragment key={item.key}>
                        {item.startsGroup && <DropdownMenuSeparator />}
                        <DropdownMenuItem asChild>
                            {item.openInNewTab ? (
                                <a
                                    className="block w-full cursor-pointer"
                                    href={item.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    {item.icon && (
                                        <Icon name={item.icon} className="me-2 size-4" />
                                    )}
                                    {item.title}
                                </a>
                            ) : (
                                <Link
                                    className="block w-full cursor-pointer"
                                    href={item.href}
                                    method={item.method}
                                    as={item.method === 'post' ? 'button' : undefined}
                                >
                                    {item.icon && (
                                        <Icon name={item.icon} className="me-2 size-4" />
                                    )}
                                    {item.title}
                                </Link>
                            )}
                        </DropdownMenuItem>
                    </Fragment>
                ))}
            </DropdownMenuGroup>
        </>
    );
}
