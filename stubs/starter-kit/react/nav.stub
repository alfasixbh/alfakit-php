import { Icon, useAlfakitNavigation } from '@alfakit/react';
import { Link } from '@inertiajs/react';
import {
    SidebarGroup,
    SidebarGroupLabel,
    SidebarMenu,
    SidebarMenuBadge,
    SidebarMenuButton,
    SidebarMenuItem,
    SidebarMenuSub,
    SidebarMenuSubButton,
    SidebarMenuSubItem,
} from '@/components/ui/sidebar';

/**
 * The AlfaKit panel navigation (resources, pages, groups, badges) in the app sidebar,
 * built from the app's own sidebar primitives. Generated by `alfakit:install --starter-kit`;
 * edit it like any other component of your app.
 */
export function AlfakitNav() {
    const { groups } = useAlfakitNavigation();

    return groups.map((group) => (
        <SidebarGroup key={group.key} className="px-2 py-0">
            {group.label && (
                <SidebarGroupLabel>{group.label}</SidebarGroupLabel>
            )}
            <SidebarMenu>
                {group.items.map((item) => (
                    <SidebarMenuItem key={item.key}>
                        <SidebarMenuButton
                            asChild
                            isActive={item.isActive}
                            tooltip={{ children: item.title }}
                        >
                            {item.openInNewTab ? (
                                <a
                                    href={item.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    {item.icon && <Icon name={item.icon} />}
                                    <span>{item.title}</span>
                                </a>
                            ) : (
                                <Link href={item.href} prefetch>
                                    {item.icon && <Icon name={item.icon} />}
                                    <span>{item.title}</span>
                                </Link>
                            )}
                        </SidebarMenuButton>
                        {item.badge !== undefined && (
                            <SidebarMenuBadge title={item.badgeTooltip}>
                                {item.badge}
                            </SidebarMenuBadge>
                        )}
                        {item.children.length > 0 && (
                            <SidebarMenuSub>
                                {item.children.map((child) => (
                                    <SidebarMenuSubItem key={child.key}>
                                        <SidebarMenuSubButton
                                            asChild
                                            isActive={child.isActive}
                                        >
                                            <Link href={child.href} prefetch>
                                                <span>{child.title}</span>
                                            </Link>
                                        </SidebarMenuSubButton>
                                    </SidebarMenuSubItem>
                                ))}
                            </SidebarMenuSub>
                        )}
                    </SidebarMenuItem>
                ))}
            </SidebarMenu>
        </SidebarGroup>
    ));
}
