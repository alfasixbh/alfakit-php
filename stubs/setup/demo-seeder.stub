<?php

declare(strict_types=1);

namespace Database\Seeders;

use {{ modelClass }};
use Illuminate\Database\Seeder;
use Illuminate\Support\Facades\Hash;
use Illuminate\Support\Facades\Schema;
use Illuminate\Support\Str;

/**
 * Demo data for trying AlfaKit locally: an admin you can sign in with and a few more users
 * for the users table. Generated by `php artisan alfakit:setup --demo`; never run it in
 * production.
 */
class AlfakitDemoSeeder extends Seeder
{
    public function run(): void
    {
        // Verified, so the demo sign-in works with ->emailVerification() too.
        $verified = Schema::hasColumn((new {{ model }})->getTable(), 'email_verified_at') ? ['email_verified_at' => now()] : [];

        $this->user('admin@example.com', ['name' => 'Admin', 'password' => Hash::make('password'), ...$verified]);

        if ({{ model }}::query()->count() < 10) {
            foreach (range(1, 12) as $index) {
                $this->user("demo{$index}@example.com", ['name' => "Demo User {$index}", 'password' => Hash::make(Str::random(32)), ...$verified]);
            }
        }
    }

    /**
     * @param  array<string, mixed>  $attributes
     */
    protected function user(string $email, array $attributes): void
    {
        if ({{ model }}::query()->where('email', $email)->exists()) {
            return;
        }

        // forceFill: the model's $fillable may not list every column the demo sets.
        (new {{ model }})->forceFill(['email' => $email, ...$attributes])->save();
    }
}
