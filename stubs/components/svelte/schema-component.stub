<script lang="ts">
  import { SchemaChildren, useSchemaComponentContext, type BaseComponent } from '@alfakit/svelte'

  /**
   * Renders {{ phpClass }} (registry key `{{ key }}`). Options from the PHP class's
   * `getSchemaProps()` arrive on `component`; `<SchemaChildren>` renders its `->schema()`.
   *
   * Auto-registered from its path in resources/js/alfakit. Type the PHP class's
   * `getSchemaProps()` with `php artisan alfakit:types` (or write `SchemaComponentProps<{ … }>`).
   */
  let { component }: { component: BaseComponent & { heading?: string | null } } = $props()

  // `context.current.get('field')` reads another field's state; `operation` / `recordKey`
  // come from `exposeContext()` on the PHP class.
  const context = useSchemaComponentContext(() => component)
</script>

<section
  data-slot="{{ key }}"
  data-operation={context.current.operation ?? undefined}
  class="rounded-xl border p-4"
>
  {#if component.heading}<h3 class="mb-4 text-base font-semibold">{component.heading}</h3>{/if}
  <SchemaChildren {component} />
</section>
