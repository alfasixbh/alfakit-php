import { FieldWrapper, useField, type FieldProps } from '@alfakit/react'

/**
 * Renders {{ phpClass }} (registry key `{{ key }}`). Options from the PHP class's
 * `getSchemaProps()` arrive on `component`. Translate visible text with `useT()`.
 *
 * Auto-registered from its path in resources/js/alfakit. Type the PHP class's
 * `getSchemaProps()` with `php artisan alfakit:types` (or write `FieldProps<{ … }>`).
 */
export default function {{ component }}({ component }: FieldProps) {
  const { value, setValue, blur, error, id, disabled, aria } = useField<string | null>(component)

  return (
    <FieldWrapper field={component} htmlFor={id} error={error}>
      <input
        id={id}
        name={component.name}
        dir="auto"
        value={value ?? ''}
        placeholder={component.placeholder}
        disabled={disabled}
        readOnly={component.readOnly}
        required={component.required}
        onChange={(event) => setValue(event.target.value)}
        onBlur={blur}
        className="border-input focus-visible:border-ring focus-visible:ring-ring/50 h-9 w-full rounded-md border bg-transparent px-3 text-sm shadow-xs outline-none focus-visible:ring-[3px]"
        {...aria}
      />
    </FieldWrapper>
  )
}
