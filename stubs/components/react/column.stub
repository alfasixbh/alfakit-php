import type { ColumnProps } from '@alfakit/react'

/**
 * Renders the cells of {{ phpClass }} (registry key `{{ key }}`). `column` holds the
 * column's `getSchemaProps()`, `cell` the record's `state` and `getCellProps()`.
 *
 * Auto-registered from its path in resources/js/alfakit. Type the PHP class's
 * `getSchemaProps()` with `php artisan alfakit:types` (or write `ColumnProps<{ … }>`).
 */
export default function {{ component }}({ cell }: ColumnProps) {
  return <span className="text-sm">{cell.state == null ? '—' : String(cell.state)}</span>
}
