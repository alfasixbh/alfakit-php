<script setup lang="ts">
import { AlfakitComponent, type StandaloneComponentSchema } from '@alfakit/vue';
import { Head } from '@inertiajs/vue3';

/**
 * An Alfakit form outside the panel. The `form` prop is `ContactForm::make()` from the
 * route; `<AlfakitComponent>` renders it with your app's shadcn tokens and no panel layout.
 */
defineProps<{ form: StandaloneComponentSchema }>();
</script>

<template>
    <Head title="Contact" />
    <div class="mx-auto w-full max-w-xl p-6">
        <h1 class="mb-6 text-2xl font-semibold">Contact us</h1>
        <AlfakitComponent :component="form" />
    </div>
</template>
