import { AlfakitComponent, type StandaloneComponentSchema } from '@alfakit/react';
import { Head } from '@inertiajs/react';

/**
 * An Inertia page of your app with an AlfaKit component: `{{ class }}` (PHP) arrives as the
 * `{{ prop }}` prop and renders in your layout with your app's shadcn tokens.
 */
export default function {{ component }}({ {{ prop }} }: { {{ prop }}: StandaloneComponentSchema }) {
    return (
        <>
            <Head title="{{ title }}" />
            <div className="mx-auto w-full max-w-5xl p-4 md:p-6">
                <AlfakitComponent component={{{ prop }}} />
            </div>
        </>
    );
}
