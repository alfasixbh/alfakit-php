/**
 * A headless page: combine `form()`, `table()`, `infolist()`, `content()`, `actions()` and
 * `widgets()` as needed. Render it from a controller:
 * `'overview' => {{ class }}::make({{ modelParameter }})`, then {{ componentTag }}.
 */
class {{ class }} extends Component
{
{{ modelProperty }}    public function actions(): array
    {
        return [
            Action::make('refresh')
                ->icon('refresh-cw')
                ->action(fn () => Notification::make()->success()->title(__('Refreshed'))->send()),
        ];
    }

    public function content(Schema $schema): Schema
    {
        return $schema->components([
            Section::make('{{ heading }}')->schema([
                Text::make('Build this component with schema components, a form(), a table() or widgets().'),
            ]),
        ]);
    }
}
