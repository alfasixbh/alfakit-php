import type Echo from 'laravel-echo';

/**
 * Laravel Echo over Reverb, as `window.Echo`, for the panel's live notifications
 * (`->realtimeNotifications()`). Generated by `php artisan alfakit:realtime`.
 * Browser only: never import this file in the SSR entry.
 *
 * Nothing connects when this file loads: AlfaKit calls the factory when a page with
 * `->realtime()` first needs Echo (`createAlfakit({ echo: () => import('./echo').then((module) => module.default()) })`,
 * or `configureAlfakit({ echo })` in a starter kit or standalone app). laravel-echo and
 * pusher-js are imported inside the factory, so they (and their CommonJS helpers) stay in
 * chunks that only load then.
 */
let echo: Promise<Echo<'reverb'> | null> | null = null;

export default function connectEcho(): Promise<Echo<'reverb'> | null> {
    const browser =
        typeof window === 'undefined'
            ? null
            : (window as unknown as { Echo?: Echo<'reverb'>; Pusher?: unknown });

    if (browser === null) {
        return Promise.resolve(null);
    }

    if (browser.Echo !== undefined) {
        return Promise.resolve(browser.Echo);
    }

    echo ??= Promise.all([import('laravel-echo'), import('pusher-js')]).then(
        ([{ default: EchoClient }, { default: Pusher }]) => {
            const env = import.meta.env;
            const scheme = String(env.VITE_REVERB_SCHEME ?? 'https');

            browser.Pusher = Pusher;
            browser.Echo = new EchoClient({
                broadcaster: 'reverb',
                key: env.VITE_REVERB_APP_KEY,
                wsHost: env.VITE_REVERB_HOST,
                wsPort: Number(env.VITE_REVERB_PORT ?? 80),
                wssPort: Number(env.VITE_REVERB_PORT ?? 443),
                forceTLS: scheme === 'https',
                enabledTransports: ['ws', 'wss'],
            });

            return browser.Echo;
        },
    );

    return echo;
}
